            "windows": [
              5,
              10
            ]
          }
        },
        {
          "kind": "sma",
          "source": "volume",
          "warmup_policy": "full_window",
          "options": {
            "windows": [
              5,
              10
            ]
          }
        },
        {
          "kind": "cvd_timed",
          "warmup_policy": "full_window",
          "options": {
            "aggregation": "100ms",
            "windows": [
              "5s",
              "30s"
            ]
          }
        }
      ]
    }
  ]
}
