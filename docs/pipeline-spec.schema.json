{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiml PipelineSpec 2.3 (with 1.0 through 2.2 read compatibility)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "feature_extractor",
    "model_input"
  ],
  "properties": {
    "version": { "enum": ["1.0", "2.0", "2.1", "2.2", "2.3"] },
    "checksum": { "type": "string" },
    "feature_extractor": { "$ref": "feature-extractor-spec.schema.json" },
    "model_input": { "$ref": "#/$defs/model_input" }
  },
  "allOf": [{
    "if": { "properties": { "version": { "enum": ["2.0", "2.1", "2.2", "2.3"] } } },
    "then": { "properties": { "model_input": { "required": ["stages"] } } },
    "else": { "properties": { "model_input": { "not": { "required": ["stages"] } } } }
  }, {
    "if": { "properties": { "version": { "const": "2.0" } } },
    "then": { "properties": { "model_input": { "properties": {
      "stages": { "items": { "not": { "properties": { "type": { "const": "scalar" } }, "required": ["type"] } } }
    } } } }
  }, {
    "if": { "properties": { "version": { "enum": ["2.0", "2.1"] } } },
    "then": { "properties": { "model_input": { "properties": {
      "stages": { "items": { "not": { "properties": { "type": { "const": "min_max_scale" } }, "required": ["type"] } } }
    } } } }
  }, {
    "if": { "properties": { "version": { "enum": ["2.0", "2.1", "2.2"] } } },
    "then": { "properties": { "model_input": { "properties": {
      "stages": { "items": { "not": { "properties": { "type": { "const": "simple_impute" } }, "required": ["type"] } } }
    } } } }
  }],
  "$defs": {
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "length", "transformations"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "transformations": {
          "type": "array",
          "items": { "$ref": "#/$defs/transformation" }
        }
      }
    },
    "transformation": {
      "oneOf": [
        { "$ref": "#/$defs/identity" },
        { "$ref": "#/$defs/lagged" },
        { "$ref": "#/$defs/standard_scale" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output"],
      "properties": {
        "type": { "const": "identity" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" }
      }
    },
    "lagged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "lag_window"],
      "properties": {
        "type": { "const": "lagged" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "lag_window": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "standard_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "mean", "scale"],
      "properties": {
        "type": { "const": "standard_scale" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "mean": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "transformations"],
          "properties": {
            "type": { "const": "scalar" },
            "transformations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transformation" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "mean", "scale"],
          "properties": {
            "type": { "const": "standard_scale" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "mean": { "$ref": "#/$defs/numeric_vector" },
            "scale": { "$ref": "#/$defs/positive_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "scale", "min"],
          "properties": {
            "type": { "const": "min_max_scale" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "scale": { "$ref": "#/$defs/positive_vector" },
            "min": { "$ref": "#/$defs/numeric_vector" },
            "clip": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [{ "type": "number" }, { "type": "number" }]
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "retained_input_indices", "replacement_values", "indicator_input_indices"],
          "properties": {
            "type": { "const": "simple_impute" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "retained_input_indices": { "$ref": "#/$defs/index_vector" },
            "replacement_values": { "type": "array", "items": { "type": "number" } },
            "indicator_input_indices": { "$ref": "#/$defs/index_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "mean", "components", "output_scale"],
          "properties": {
            "type": { "const": "pca" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "mean": { "$ref": "#/$defs/numeric_vector" },
            "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numeric_vector" } },
            "output_scale": { "$ref": "#/$defs/positive_vector" }
          }
        }
      ]
    },
    "stage_outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/output_feature_id" }
    },
    "numeric_vector": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "positive_vector": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "index_vector": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "feature_id": { "type": "string" },
    "output_feature_id": {
      "type": "string",
      "not": { "pattern": "^__reserved_" }
    }
  }
}
