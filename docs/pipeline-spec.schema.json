{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiml PipelineSpec 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodes",
    "outputs"
  ],
  "properties": {
    "version": {
      "const": "4.0"
    },
    "checksum": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/extractor_node"
        }
      ],
      "items": {
        "$ref": "#/$defs/transform_node"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "$defs": {
    "extractor_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "spec"
      ],
      "properties": {
        "type": {
          "const": "extractor"
        },
        "spec": {
          "$ref": "feature-extractor-spec.schema.json"
        }
      }
    },
    "transform_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parent",
        "stage"
      ],
      "properties": {
        "type": {
          "const": "transform"
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "node"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!__reserved_).*\\S.*$"
        },
        "node": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "transformation": {
      "oneOf": [
        { "$ref": "#/$defs/state" },
        { "$ref": "#/$defs/average" },
        { "$ref": "#/$defs/rolling_statistic" },
        { "$ref": "#/$defs/rolling_statistic_timed" },
        { "$ref": "#/$defs/identity" },
        { "$ref": "#/$defs/lagged" },
        { "$ref": "#/$defs/change" },
        { "$ref": "#/$defs/timed_change" },
        { "$ref": "#/$defs/standard_scale" }
      ]
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "input", "output", "epsilon"],
      "properties": {
        "type": { "enum": ["positive_streak", "negative_streak", "observations_since_positive", "observations_since_negative", "observations_since_nonzero", "time_since_positive", "time_since_negative", "time_since_nonzero"] },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "epsilon": { "type": "number", "minimum": 0 }
      }
    },
    "average": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "input", "output", "window", "warmup_policy"],
      "properties": {
        "type": { "enum": ["sma", "ema"] },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "window": { "type": "integer", "minimum": 1 },
        "warmup_policy": { "enum": ["first_value", "full_window"] }
      }
    },
    "rolling_statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "input",
        "output",
        "window",
        "warmup_policy"
      ],
      "properties": {
        "type": {
          "enum": [
            "rolling_std",
            "rolling_min",
            "rolling_max",
            "rolling_range",
            "rolling_slope",
            "rolling_path_length",
            "rolling_positive_movement",
            "rolling_negative_movement",
            "rolling_direction_change_count",
            "rolling_max_drawdown"
          ]
        },
        "input": {
          "$ref": "#/$defs/feature_id"
        },
        "output": {
          "$ref": "#/$defs/output_feature_id"
        },
        "window": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_policy": {
          "enum": [
            "first_value",
            "full_window"
          ]
        }
      }
    },
    "rolling_statistic_timed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "input",
        "output",
        "window",
        "warmup_policy"
      ],
      "properties": {
        "type": {
          "enum": [
            "rolling_std_timed",
            "rolling_min_timed",
            "rolling_max_timed",
            "rolling_range_timed"
          ]
        },
        "input": {
          "$ref": "#/$defs/feature_id"
        },
        "output": {
          "$ref": "#/$defs/output_feature_id"
        },
        "window": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "warmup_policy": {
          "enum": [
            "first_value",
            "full_window"
          ]
        },
        "aggregation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$",
          "default": "1ms"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output"],
      "properties": {
        "type": { "const": "identity" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" }
      }
    },
    "lagged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "lag_window"],
      "properties": {
        "type": { "const": "lagged" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "lag_window": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "lag_window"],
      "properties": {
        "type": { "enum": ["delta", "simple_return", "log_return"] },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "lag_window": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "timed_change": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "input", "output", "lag_window"],
      "properties": {
        "type": { "enum": ["lagged_timed", "delta_timed", "simple_return_timed", "log_return_timed"] },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "lag_window": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
        "aggregation": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$", "default": "1ms" }
      }
    },
    "standard_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "mean", "scale"],
      "properties": {
        "type": { "const": "standard_scale" },
        "input": { "$ref": "#/$defs/feature_id" },
        "output": { "$ref": "#/$defs/output_feature_id" },
        "mean": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "input", "outputs", "window", "warmup_policy"],
          "properties": {
            "type": { "const": "rolling_path_signature" },
            "input": { "$ref": "#/$defs/feature_id" },
            "outputs": { "$ref": "#/$defs/stage_outputs", "minItems": 6, "maxItems": 6 },
            "window": { "type": "integer", "minimum": 1 },
            "warmup_policy": { "enum": ["first_value", "full_window"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "input_indices"],
          "properties": {
            "type": { "const": "select" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "input_indices": { "$ref": "#/$defs/nonempty_index_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "transformations"],
          "properties": {
            "type": { "const": "scalar" },
            "transformations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transformation" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "mean", "scale"],
          "properties": {
            "type": { "const": "standard_scale" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "mean": { "$ref": "#/$defs/numeric_vector" },
            "scale": { "$ref": "#/$defs/positive_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "scale", "min"],
          "properties": {
            "type": { "const": "min_max_scale" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "scale": { "$ref": "#/$defs/positive_vector" },
            "min": { "$ref": "#/$defs/numeric_vector" },
            "clip": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [{ "type": "number" }, { "type": "number" }]
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "retained_input_indices", "replacement_values", "indicator_input_indices"],
          "properties": {
            "type": { "const": "simple_impute" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "retained_input_indices": { "$ref": "#/$defs/index_vector" },
            "replacement_values": { "type": "array", "items": { "type": "number" } },
            "indicator_input_indices": { "$ref": "#/$defs/index_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "method", "lambdas", "mean", "scale"],
          "properties": {
            "type": { "const": "power_transform" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "method": { "enum": ["yeo-johnson", "box-cox"] },
            "lambdas": { "$ref": "#/$defs/numeric_vector" },
            "mean": { "$ref": "#/$defs/numeric_vector" },
            "scale": { "$ref": "#/$defs/positive_vector" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "output_distribution", "quantiles", "references", "all_nan_input_indices", "bounds_threshold"],
          "properties": {
            "type": { "const": "quantile_transform" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "output_distribution": { "enum": ["uniform", "normal"] },
            "quantiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numeric_vector" } },
            "references": { "$ref": "#/$defs/probability_vector" },
            "all_nan_input_indices": { "$ref": "#/$defs/index_vector" },
            "bounds_threshold": { "type": "number", "minimum": 0 },
            "normal_clip": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [{ "type": "number" }, { "type": "number" }]
            }
          },
          "allOf": [{
            "if": { "properties": { "output_distribution": { "const": "normal" } }, "required": ["output_distribution"] },
            "then": { "required": ["normal_clip"] },
            "else": { "not": { "required": ["normal_clip"] } }
          }]
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "outputs", "mean", "components", "output_scale"],
          "properties": {
            "type": { "const": "pca" },
            "outputs": { "$ref": "#/$defs/stage_outputs" },
            "mean": { "$ref": "#/$defs/numeric_vector" },
            "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numeric_vector" } },
            "output_scale": { "$ref": "#/$defs/positive_vector" }
          }
        }
      ]
    },
    "stage_outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/output_feature_id" }
    },
    "numeric_vector": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "probability_vector": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "positive_vector": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "index_vector": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "nonempty_index_vector": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "feature_id": { "type": "string" },
    "output_feature_id": {
      "type": "string",
      "not": { "pattern": "^__reserved_" }
    }
  }
}
