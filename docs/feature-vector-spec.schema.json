{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiml FeatureVectorSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "feature_vector_capacity", "feature_vector_length", "features"],
  "properties": {
    "version": { "const": "1.0" },
    "feature_vector_capacity": { "type": "integer", "minimum": 0 },
    "feature_vector_length": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/group" } }
  },
  "$defs": {
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "indicators"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "indicators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/indicator" } }
      }
    },
    "indicator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["sma", "ema", "cvd", "sma_timed", "obv_timed", "trade_count_timed", "day_of_week", "time_since_first_event_of_day"] },
        "source": { "$ref": "#/$defs/source" },
        "warmup_policy": { "enum": ["first_value", "full_window"] },
        "options": { "$ref": "#/$defs/options" },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "price" },
            "field": { "const": "value" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "volume" },
            "field": { "const": "value" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "trade" },
            "field": { "const": "price" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "trade" },
            "field": { "const": "volume" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event"],
          "properties": {
            "type": { "const": "event" },
            "event": { "enum": ["price", "volume", "trade", "order_book_delta", "order_book_snapshot", "time"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "every_event" } }
        }
      ]
    },
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "aggregation": { "$ref": "#/$defs/duration" },
        "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "window": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/duration" }] },
        "id": { "type": "string", "not": { "pattern": "^__reserved_" } }
      }
    },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }
  }
}
