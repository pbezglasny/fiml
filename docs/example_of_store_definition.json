{
  "version": "3.0",
  "checksum": "opaque model metadata",
  "feature_extractor": {
    "version": "2.0",
    "capacity": 8,
    "length": 5,
    "required_events": [
      {
        "symbol": "__global__",
        "event": "time"
      },
      {
        "symbol": "btcusd",
        "event": "order_book_delta"
      },
      {
        "symbol": "btcusd",
        "event": "order_book_snapshot"
      },
      {
        "symbol": "btcusd",
        "event": "trade"
      }
    ],
    "checksum": "opaque raw-feature metadata",
    "features": [
      {
        "symbol": "__global__",
        "indicators": [
          {
            "kind": "day_of_week",
            "source": {
              "type": "any_event"
            },
            "outputs": [
              {
                "id": "raw_day"
              }
            ]
          }
        ]
      },
      {
        "symbol": "btcusd",
        "indicators": [
          {
            "kind": "field",
            "source": {
              "type": "field",
              "event": "trade",
              "field": "price"
            }
          },
          {
            "kind": "order_book_mid_price",
            "source": {
              "type": "order_book"
            },
            "outputs": [
              {
                "id": "raw_mid_price"
              }
            ]
          },
          {
            "kind": "order_book_imbalance",
            "source": {
              "type": "order_book"
            },
            "outputs": [
              {
                "n_levels": 1,
                "id": "raw_imbalance_1"
              },
              {
                "n_levels": 5,
                "id": "raw_imbalance_5"
              }
            ]
          }
        ]
      }
    ]
  },
  "model_input": {
    "stages": [
      {
        "type": "scalar",
        "transformations": [
          {
            "type": "identity",
            "input": "raw_day",
            "output": "day"
          },
          {
            "type": "standard_scale",
            "input": "raw_sma",
            "output": "scaled_sma",
            "mean": 4.0,
            "scale": 2.0
          },
          {
            "type": "identity",
            "input": "raw_mid_price",
            "output": "mid_price"
          },
          {
            "type": "identity",
            "input": "raw_imbalance_1",
            "output": "imbalance_1"
          },
          {
            "type": "identity",
            "input": "raw_imbalance_5",
            "output": "imbalance_5"
          }
        ]
      }
    ],
    "capacity": 8,
    "length": 5,
    "transformations": [
      {
        "type": "sma",
        "input": "field:symbol=6:btcusd:source=field.trade_price",
        "output": "raw_sma",
        "window": 5,
        "warmup_policy": "full_window"
      },
      {
        "type": "identity",
        "input": "raw_day",
        "output": "raw_day"
      },
      {
        "type": "identity",
        "input": "raw_imbalance_1",
        "output": "raw_imbalance_1"
      },
      {
        "type": "identity",
        "input": "raw_imbalance_5",
        "output": "raw_imbalance_5"
      },
      {
        "type": "identity",
        "input": "raw_mid_price",
        "output": "raw_mid_price"
      }
    ]
  }
}
