{
  "version": "1.0",
  "checksum": "opaque model metadata",
  "feature_extractor": {
    "version": "1.0",
    "capacity": 4,
    "length": 2,
    "checksum": "opaque raw-feature metadata",
    "features": [
      {
        "symbol": "__global__",
        "indicators": [
          {
            "kind": "day_of_week",
            "source": {
              "type": "any_event"
            },
            "outputs": [
              {
                "id": "raw_day"
              }
            ]
          }
        ]
      },
      {
        "symbol": "btcusd",
        "indicators": [
          {
            "kind": "sma",
            "source": {
              "type": "field",
              "event": "trade",
              "field": "price"
            },
            "warmup_policy": "full_window",
            "outputs": [
              {
                "window": 5,
                "id": "raw_sma"
              }
            ]
          }
        ]
      }
    ]
  },
  "model_input": {
    "capacity": 4,
    "length": 2,
    "transformations": [
      {
        "type": "identity",
        "input": "raw_day",
        "output": "day"
      },
      {
        "type": "standard_scale",
        "input": "raw_sma",
        "output": "scaled_sma",
        "mean": 4.0,
        "scale": 2.0
      }
    ]
  }
}
