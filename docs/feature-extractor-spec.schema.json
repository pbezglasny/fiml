{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiml FeatureExtractorSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capacity", "length", "features"],
  "properties": {
    "version": { "const": "1.0" },
    "capacity": { "type": "integer", "minimum": 0 },
    "length": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/group" } }
  },
  "$defs": {
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "indicators"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "indicators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/indicator" } }
      }
    },
    "indicator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["sma", "ema", "cvd", "sma_timed", "obv_timed", "trade_count_timed", "day_of_week", "time_since_first_event_of_day", "order_book_mid_price", "order_book_spread", "order_book_spread_bps", "order_book_weighted_mid_price", "order_book_microprice", "order_book_imbalance"] },
        "source": { "$ref": "#/$defs/source" },
        "warmup_policy": { "enum": ["first_value", "full_window"] },
        "options": { "$ref": "#/$defs/options" },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "pattern": "^order_book_" } } },
          "then": {
            "properties": {
              "source": { "const": { "type": "order_book" } },
              "warmup_policy": false,
              "options": { "maxProperties": 0 },
              "outputs": { "maxItems": 16, "items": { "not": { "required": ["window"] } } }
            },
            "if": { "properties": { "kind": { "const": "order_book_imbalance" } } },
            "then": {
              "required": ["outputs"],
              "properties": { "outputs": { "items": { "required": ["n_levels"] } } }
            },
            "else": {
              "properties": { "outputs": { "maxItems": 1, "items": { "not": { "required": ["n_levels"] } } } }
            }
          },
          "else": {
            "properties": {
              "source": { "not": { "properties": { "type": { "const": "order_book" } } } },
              "outputs": { "items": { "not": { "required": ["n_levels"] } } }
            }
          }
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "order_book" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "price" },
            "field": { "const": "value" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "volume" },
            "field": { "const": "value" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "trade" },
            "field": { "const": "price" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event", "field"],
          "properties": {
            "type": { "const": "field" },
            "event": { "const": "trade" },
            "field": { "const": "volume" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "event"],
          "properties": {
            "type": { "const": "event" },
            "event": { "enum": ["price", "volume", "trade", "order_book_delta", "order_book_snapshot", "time"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "any_event" } }
        }
      ]
    },
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "aggregation": { "$ref": "#/$defs/duration" },
        "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "n_levels": { "type": "integer", "minimum": 1 },
        "window": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/duration" }] },
        "id": { "type": "string", "not": { "pattern": "^__reserved_" } }
      }
    },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }
  }
}
