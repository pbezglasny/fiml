{
  "version": "3.0",
  "feature_extractor": {
    "version": "2.0",
    "capacity": 5,
    "length": 3,
    "required_events": [
      {
        "symbol": "__global__",
        "event": "time"
      },
      {
        "symbol": "btcusdt",
        "event": "trade"
      }
    ],
    "features": [
      {
        "symbol": "__global__",
        "indicators": [
          {
            "kind": "day_of_week",
            "source": {
              "type": "any_event"
            },
            "outputs": [
              {
                "id": "raw_day"
              }
            ]
          },
          {
            "kind": "time_since_first_event_of_day",
            "source": {
              "type": "any_event"
            },
            "options": {
              "utc_offset": "+00:00"
            },
            "outputs": [
              {
                "id": "raw_elapsed"
              }
            ]
          }
        ]
      },
      {
        "symbol": "btcusdt",
        "indicators": [
          {
            "kind": "field",
            "source": {
              "type": "field",
              "event": "trade",
              "field": "price"
            }
          }
        ]
      }
    ]
  },
  "model_input": {
    "stages": [
      {
        "type": "scalar",
        "transformations": [
          {
            "type": "standard_scale",
            "input": "raw_sma",
            "output": "scaled_sma",
            "mean": 10.0,
            "scale": 2.0
          },
          {
            "type": "identity",
            "input": "raw_elapsed",
            "output": "elapsed"
          },
          {
            "type": "identity",
            "input": "raw_day",
            "output": "day"
          }
        ]
      }
    ],
    "capacity": 5,
    "length": 3,
    "transformations": [
      {
        "type": "sma",
        "input": "field:symbol=7:btcusdt:source=field.trade_price",
        "output": "raw_sma",
        "window": 2,
        "warmup_policy": "full_window"
      },
      {
        "type": "identity",
        "input": "raw_day",
        "output": "raw_day"
      },
      {
        "type": "identity",
        "input": "raw_elapsed",
        "output": "raw_elapsed"
      }
    ]
  }
}
